<Window x:Class="SpaceInspector.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Inspector" Width="1160" Height="760" MinWidth="920" MinHeight="640" Background="#F3F6FA" FontFamily="Malgun Gothic" FontSize="14" WindowStartupLocation="CenterScreen" Language="ko-KR">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#172B43" Padding="24,32">
      <StackPanel>
        <TextBlock Text="SPACE&#x0a;INSPECTOR" Foreground="White" FontSize="23" FontWeight="Bold" />
        <TextBlock Text="내 파일을 이해하는 공간" Foreground="#BDCEE1" Margin="0,12,0,36" FontSize="12" />
        <Border Background="#2D4867" CornerRadius="6" Padding="12"><TextBlock Text="대시보드" Foreground="White" FontWeight="Bold" /></Border>
        <TextBlock Text="파일 검색 · 준비 중" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="파일 탐색 · 준비 중" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="중복 검색 · 준비 중" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="OneDrive · 준비 중" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="설정 · 준비 중" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="개발 미리보기 · Phase 1" Foreground="#BDCEE1" Margin="0,64,0,0" FontSize="11" />
      </StackPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="저장 공간 대시보드" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="로컬 드라이브와 인덱스 상태를 확인하세요." Margin="0,8,0,24" Foreground="#596B80" />
      </StackPanel>
      <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
        <StackPanel><TextBlock Text="파일 인덱스" FontWeight="Bold" /><TextBlock Text="{Binding IndexStatus}" FontSize="21" Margin="0,8,0,8" /><TextBlock Text="파일 정보는 이 PC에 저장됩니다. 원본 파일은 변경하지 않습니다." Foreground="#596B80" TextWrapping="Wrap" /></StackPanel>
      </Border>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding RefreshCommand}" /><TextBlock Text="드라이브 선택" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" /></DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Drives}" Background="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="16" /></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Snapshot.IsReady}" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.Name="검사 대상 드라이브 선택" />
              <StackPanel Grid.Column="1"><TextBlock FontWeight="Bold"><Run Text="{Binding Snapshot.RootPath, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Snapshot.Label, Mode=OneWay}" /></TextBlock>
                <TextBlock Text="{Binding Snapshot.CapacityText}" Foreground="#596B80" Margin="0,6,0,6" />
                <ProgressBar Value="{Binding Snapshot.UsedPercent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="6" Foreground="#3679CF" Background="#E8EFF7" BorderThickness="0" />
              </StackPanel>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Background="#E8EFF7" CornerRadius="6" Padding="16" Margin="0,18,0,0">
          <StackPanel><TextBlock Text="검사 결과" FontWeight="Bold" /><TextBlock Text="아직 검사를 실행하지 않았습니다. 파일 인덱싱은 다음 개발 단계에서 제공됩니다." TextWrapping="Wrap" Margin="0,8,0,12" /><Button Content="검사 시작 · 준비 중" IsEnabled="False" HorizontalAlignment="Left" /></StackPanel>
        </Border>
      </Grid>
      <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,18,0,0" Foreground="#596B80" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
