<Window x:Class="SpaceInspector.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Inspector" Width="1280" Height="900" MinWidth="1040" MinHeight="760" Background="#F3F6FA" FontFamily="Malgun Gothic" FontSize="13" WindowStartupLocation="CenterScreen" Language="ko-KR">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserSortColumns" Value="False" /><Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" /><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="RowHeight" Value="30" /><Setter Property="BorderThickness" Value="0" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="#E8EFF7" /></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#172B43" Padding="22,30">
      <StackPanel>
        <TextBlock Text="SPACE&#x0a;INSPECTOR" Foreground="White" FontSize="23" FontWeight="Bold" />
        <TextBlock Text="내 파일을 이해하는 공간" Foreground="#BDCEE1" Margin="0,12,0,32" FontSize="12" />
        <Border Background="#2D4867" CornerRadius="6" Padding="12"><TextBlock Text="파일 인덱스" Foreground="White" FontWeight="Bold" /></Border>
        <TextBlock Text="조건 검색 · 아래 검색 탭" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="중복 분석 · 아래 분석 탭" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="OneDrive · 준비 중" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="설정 · 준비 중" Foreground="#BDCEE1" Margin="12,24,0,0" />
        <TextBlock Text="개발 미리보기 · Phase 4" Foreground="#BDCEE1" Margin="0,64,0,0" FontSize="11" />
        <TextBlock Text="원본 파일을 변경하지&#x0a;않습니다." Foreground="#BDCEE1" Margin="0,14,0,0" FontSize="12" />
      </StackPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="220" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="저장 인덱스 새로고침" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        <StackPanel><TextBlock Text="파일 인덱스" FontSize="27" FontWeight="Bold" /><TextBlock Text="{Binding IndexStatus}" Margin="0,6,0,0" Foreground="#596B80" /></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" IsEnabled="{Binding CanEditScope}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="White" CornerRadius="8" Padding="16">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="전체 선택" Command="{Binding SelectAllDrivesCommand}" Padding="10,4" /><TextBlock Text="로컬 드라이브" FontWeight="Bold" VerticalAlignment="Center" /></DockPanel>
            <ListBox ItemsSource="{Binding Drives}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="4,8" /></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Snapshot.IsReady}" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="검사 대상 드라이브 선택" />
                <StackPanel Grid.Column="1"><TextBlock FontWeight="Bold"><Run Text="{Binding Snapshot.RootPath, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Snapshot.Label, Mode=OneWay}" /></TextBlock>
                  <TextBlock Text="{Binding Snapshot.CapacityText}" Foreground="#596B80" Margin="0,4,0,5" FontSize="12" />
                  <ProgressBar Value="{Binding Snapshot.UsedPercent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="5" Foreground="#3679CF" Background="#E8EFF7" BorderThickness="0" />
                </StackPanel>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="폴더 추가" Command="{Binding AddFolderCommand}" Padding="10,4" /><Button Content="선택 제외" Command="{Binding RemoveFolderCommand}" Padding="10,4" /></StackPanel><TextBlock Text="선택 폴더" FontWeight="Bold" VerticalAlignment="Center" /></DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="드라이브·폴더를 함께 선택할 수 있습니다. 겹치는 범위는 한 번만 검사합니다." Foreground="#596B80" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="#E8EFF7" CornerRadius="8" Padding="16" Margin="0,16,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" MaxHeight="42" /><ProgressBar IsIndeterminate="{Binding IsWorking}" Height="4" Margin="0,10,16,0" Foreground="#3679CF" BorderThickness="0" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="검사 시작 / 재검사" Command="{Binding ScanCommand}" /><Button Content="취소" Command="{Binding CancelCommand}" /></StackPanel>
        </Grid>
      </Border>
      <TabControl Grid.Row="3" BorderThickness="0" Background="White" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="검색 조건"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" IsEnabled="{Binding CanEditScope}">
          <TextBlock Text="저장 인덱스 검색 · 입력한 조건을 모두 만족하는 파일을 찾습니다." FontWeight="Bold" Margin="0,0,0,12" />
          <WrapPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="파일명 포함" /><TextBox Width="220" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6" /></StackPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="확장자 (예: pdf, jpg, mp4)" /><TextBox Width="220" Text="{Binding ExtensionsFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6" /></StackPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="최소 크기 (MiB)" /><TextBox Width="120" Text="{Binding MinimumSize, UpdateSourceTrigger=PropertyChanged}" Padding="6" /></StackPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="최대 크기 (MiB)" /><TextBox Width="120" Text="{Binding MaximumSize, UpdateSourceTrigger=PropertyChanged}" Padding="6" /></StackPanel>
          </WrapPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="생성일 시작" /><DatePicker Width="170" SelectedDate="{Binding CreatedFrom}" /></StackPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="생성일 끝 (당일 포함)" /><DatePicker Width="170" SelectedDate="{Binding CreatedTo}" /></StackPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="수정일 시작" /><DatePicker Width="170" SelectedDate="{Binding ModifiedFrom}" /></StackPanel>
            <StackPanel Margin="0,0,16,12"><TextBlock Text="수정일 끝 (당일 포함)" /><DatePicker Width="170" SelectedDate="{Binding ModifiedTo}" /></StackPanel>
          </WrapPanel>
          <WrapPanel Margin="0,0,0,14">
            <CheckBox Content="위에서 선택한 드라이브·폴더로 검색 범위 제한" IsChecked="{Binding SearchSelectedScope}" VerticalAlignment="Center" Margin="0,0,20,8" />
            <ComboBox Width="120" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" Margin="0,0,12,8" />
            <CheckBox Content="내림차순" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="0,0,0,8" />
          </WrapPanel>
          <WrapPanel><Button Content="검색 적용" Command="{Binding SearchCommand}" /><Button Content="조건 초기화" Command="{Binding ResetSearchCommand}" /><Button Content="기준 파일 선택" Command="{Binding ReferenceFileCommand}" /></WrapPanel>
          <TextBlock Text="검색 후 ‘저장된 파일’ 탭에서 결과를 확인하세요. 기준 파일은 이름·확장자를 가져오며 콘텐츠 중복 여부는 아직 판정하지 않습니다. 날짜는 이 PC의 현지 날짜를 기준으로 합니다." TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#596B80" />
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="저장된 파일"><Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,10"><Button Content="경로 복사" Command="{Binding CopyPathCommand}" /><Button Content="탐색기에서 위치 열기" Command="{Binding RevealFileCommand}" /><TextBlock Text="정상 = 메타데이터 수집 성공" Foreground="#596B80" VerticalAlignment="Center" /></WrapPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="180" />
              <DataGridTextColumn Header="실제 경로" Binding="{Binding FullPath}" Width="*" MinWidth="180" />
              <DataGridTextColumn Header="크기 (바이트)" Binding="{Binding FileSize, StringFormat=N0}" Width="105" />
              <DataGridTextColumn Header="수정 시각 (UTC)" Binding="{Binding ModifiedTimeUtc}" Width="160" />
              <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="125" />
              <DataGridTextColumn Header="클라우드 속성" Binding="{Binding CloudText}" Width="145" />
              <DataGridTextColumn Header="볼륨 식별" Binding="{Binding DeviceText}" Width="280" />
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="이전" Command="{Binding PreviousPageCommand}" /><Button Content="다음" Command="{Binding NextPageCommand}" /></StackPanel><TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="#596B80" /></DockPanel>
        </Grid></TabItem>
        <TabItem Header="마지막 검사 오류 / 건너뜀"><DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="최대 100개 표시 · 전체 기록은 로컬 DB에 저장됩니다. 링크·클라우드 폴더·앱 폴더는 건너뜁니다." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#596B80" />
          <DataGrid ItemsSource="{Binding Issues}"><DataGrid.Columns><DataGridTextColumn Header="경로" Binding="{Binding Path}" Width="2*" /><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="130" /><DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="2*" /></DataGrid.Columns></DataGrid>
        </DockPanel></TabItem>
        <TabItem Header="중복 분석"><Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel IsEnabled="{Binding CanEditScope}" Margin="0,0,0,8">
            <ComboBox Width="175" ItemsSource="{Binding DuplicateLevels}" SelectedIndex="{Binding DuplicateLevelIndex}" Margin="0,0,10,4" />
            <CheckBox Content="시스템·프로그램 범위 포함" IsChecked="{Binding IncludeProtectedDuplicates}" VerticalAlignment="Center" Margin="0,0,12,4" />
            <Button Content="중복 분석 시작" Command="{Binding AnalyzeDuplicatesCommand}" Padding="10,5" />
          </WrapPanel>
          <TextBlock Grid.Row="1" Text="저장 인덱스 전체 대상 · 장치 확인을 위해 기존 인덱스는 먼저 재검사하세요. 링크·클라우드 콘텐츠는 제외합니다. 논리적 중복량은 실제 확보 가능한 공간과 다르며, 원본은 변경하지 않습니다." TextWrapping="Wrap" Foreground="#596B80" Margin="0,0,0,8" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedDuplicateGroup}"><DataGrid.Columns>
            <DataGridTextColumn Header="판정" Binding="{Binding StatusText}" Width="160" />
            <DataGridTextColumn Header="경로 수" Binding="{Binding FileCount}" Width="80" />
            <DataGridTextColumn Header="실제 데이터 수" Binding="{Binding DataCountText}" Width="110" />
            <DataGridTextColumn Header="중복량" Binding="{Binding SpaceText}" Width="*" />
          </DataGrid.Columns></DataGrid>
          <WrapPanel Grid.Row="3" Margin="0,8,0,8"><Button Content="이전 그룹" Command="{Binding PreviousGroupsCommand}" Padding="8,4" /><Button Content="다음 그룹" Command="{Binding NextGroupsCommand}" Padding="8,4" /><Button Content="선택 그룹 파일 보기" Command="{Binding LoadDuplicateMembersCommand}" Padding="8,4" /><Button Content="경로 복사" Command="{Binding CopyPathCommand}" Padding="8,4" /><Button Content="탐색기 위치" Command="{Binding RevealFileCommand}" Padding="8,4" /></WrapPanel>
          <DataGrid Grid.Row="4" ItemsSource="{Binding DuplicateMembers}" SelectedItem="{Binding SelectedDuplicateMember}"><DataGrid.Columns>
            <DataGridTextColumn Header="실제 경로" Binding="{Binding FullPath}" Width="2*" />
            <DataGridTextColumn Header="크기 (바이트)" Binding="{Binding FileSize, StringFormat=N0}" Width="110" />
            <DataGridTextColumn Header="미검증 사유" Binding="{Binding Error}" Width="*" />
          </DataGrid.Columns></DataGrid>
          <DockPanel Grid.Row="5" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="이전 파일" Command="{Binding PreviousMembersCommand}" Padding="8,4" /><Button Content="다음 파일" Command="{Binding NextMembersCommand}" Padding="8,4" /></StackPanel><TextBlock Text="{Binding DuplicatePageText}" VerticalAlignment="Center" /></DockPanel>
        </Grid></TabItem>
      </TabControl>
      <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,14,0,0" Foreground="#596B80" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
