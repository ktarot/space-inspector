<UserControl x:Class="SpaceInspector.App.Views.FileBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpaceInspector.App.Views" x:Name="Root">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="EnableRowVirtualization" Value="True"/></Style></UserControl.Resources>
 <DockPanel>
  <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
   <ComboBox x:Name="Mode" SelectedIndex="0" Width="150" VerticalContentAlignment="Center"><ComboBoxItem>목록</ComboBoxItem><ComboBoxItem>목록 + 썸네일</ComboBoxItem><ComboBoxItem>썸네일 격자</ComboBoxItem></ComboBox>
   <TextBlock Text="크기" Margin="12,6"/><Slider x:Name="Size" Minimum="100" Maximum="260" Value="150" Width="120" VerticalAlignment="Center"/>
   <CheckBox x:Name="PreviewToggle" Content="미리보기" IsChecked="True"/><Button x:Name="PinButton" Content="선택 파일을 비교 기준으로"/><Button x:Name="ClearComparisonButton" Content="비교 해제"/>
   <TextBlock x:Name="SelectionHint" Text="Ctrl/Shift: 여러 파일 선택 · 현재 페이지만" Margin="8,6"/>
  </WrapPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="PreviewColumn" Width="280"/></Grid.ColumnDefinitions>
   <Grid>
    <DataGrid x:Name="FileList" ItemsSource="{Binding Items, ElementName=Root}">
     <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Mode}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
     <DataGrid.Columns>
      <DataGridTemplateColumn x:Name="ThumbnailColumn" Header="미리보기" Width="110" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:ImagePreview Item="{Binding}" Height="65"></local:ImagePreview></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="180"/><DataGridTextColumn Header="크기 (바이트)" Binding="{Binding FileSize, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="비교 상태" Binding="{Binding ComparisonText}" Width="110"/><DataGridTextColumn Header="파일 상태" Binding="{Binding StatusText}" Width="120"/><DataGridTextColumn Header="보관" Binding="{Binding KeepText}" Width="85"/><DataGridTextColumn Header="경로" Binding="{Binding FullPath}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
    <ListBox x:Name="ThumbList" SelectionMode="Extended" ItemsSource="{Binding Items, ElementName=Root}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Mode}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Width="{Binding Value, ElementName=Size}" Margin="4"><local:ImagePreview Item="{Binding}" Height="{Binding Value, ElementName=Size}"/><TextBlock Text="{Binding KeepText}" Foreground="#2F7056"/><TextBlock Text="{Binding ComparisonText}" Foreground="#52647A"/><TextBlock Text="{Binding StatusText}" Foreground="#52647A"/><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding FileSize, StringFormat={}{0:N0} 바이트}" Foreground="#52647A"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
   <Grid Grid.Column="2" Visibility="{Binding IsChecked, ElementName=PreviewToggle, Converter={StaticResource BoolToVisibility}}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="CompareHint" Text="선택한 파일" Margin="8" TextWrapping="Wrap"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PinnedColumn" Width="0"/></Grid.ColumnDefinitions>
     <DockPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding Selection.FullPath, ElementName=Root}" TextWrapping="Wrap" Margin="10"/><local:MediaPreview x:Name="SelectedPreview" Item="{Binding Selection, ElementName=Root}"/></DockPanel>
     <DockPanel x:Name="PinnedPanel" Grid.Column="1" Visibility="Collapsed"><TextBlock DockPanel.Dock="Bottom" x:Name="PinnedPath" TextWrapping="Wrap" Margin="10"/><local:MediaPreview x:Name="PinnedPreview"/></DockPanel>
    </Grid>
   </Grid>
  </Grid>
 </DockPanel>
</UserControl>
